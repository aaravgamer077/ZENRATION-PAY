rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNumber(val) {
      return val is int || val is float;
    }

    // Authorised Administrator Check:
    // Verifies either a trusted document in /admins/{uid} OR the bootstrapped verified project owner email.
    // Never trusts unverified emails.
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'nankidevi6746@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Validation Blueprint: User Profile (/users/{userId})
    function isValidUser(data, pathUserId) {
      return (!('userId' in data) || (data.userId is string && data.userId == pathUserId)) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100)) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('upiId' in data) || data.upiId == null || (data.upiId is string && data.upiId.size() <= 100)) &&
             (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
             (!('biometricSimEnabled' in data) || data.biometricSimEnabled is bool) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Validation Blueprint: Demo Balance (/balances/{userId})
    function isValidBalance(data, pathUserId) {
      return (!('userId' in data) || (data.userId is string && data.userId == pathUserId)) &&
             isNumber(data.demoBalance) && data.demoBalance >= 0 && data.demoBalance <= 1000000000 &&
             (!('balance' in data) || (isNumber(data.balance) && data.balance >= 0 && data.balance <= 1000000000)) &&
             (!('currency' in data) || (data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10)) &&
             (!('isDemo' in data) || (data.isDemo is bool && data.isDemo == true)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Validation Blueprint: Simulated Transaction (/transactions/{transactionId})
    function isValidTransaction(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             (!('userId' in data) || (data.userId is string && data.userId == request.auth.uid)) &&
             isNumber(data.amount) && data.amount > 0 && data.amount <= 10000000 &&
             data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 100 &&
             data.recipientUPI is string && data.recipientUPI.size() >= 3 && data.recipientUPI.size() <= 100 &&
             (!('recipientUpiId' in data) || (data.recipientUpiId is string && data.recipientUpiId.size() >= 3 && data.recipientUpiId.size() <= 100)) &&
             (!('currency' in data) || (data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10)) &&
             data.status is string && (data.status == 'SIMULATED' || data.status == 'SIMULATED – NOT PAID') &&
             (!('isSimulated' in data) || (data.isSimulated is bool && data.isSimulated == true)) &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 200)) &&
             (!('referenceId' in data) || (data.referenceId is string && data.referenceId.size() >= 4 && data.referenceId.size() <= 64)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 0. Admins Collection (/admins/{adminUid}) - Read-only from client; managed via Console
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // 1. Users Collection (/users/{userId})
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && ((existing().get('userId', '') == request.auth.uid) || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['name', 'email', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'displayName', 'email', 'photoURL', 'photoUrl', 'upiId', 'notificationsEnabled', 'biometricSimEnabled', 'createdAt', 'updatedAt']) &&
                       isValidUser(incoming(), userId);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       (request.auth.uid == userId || isAdmin()) &&
                       isValidUser(incoming(), userId) &&
                       incoming().createdAt == existing().createdAt &&
                       (!('userId' in existing()) || incoming().userId == existing().userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'displayName', 'email', 'photoURL', 'photoUrl', 'upiId', 'notificationsEnabled', 'biometricSimEnabled', 'updatedAt']);

      allow delete: if false;
    }

    // 2. Balances Collection (/balances/{userId})
    match /balances/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && ((existing().get('userId', '') == request.auth.uid) || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       (request.auth.uid == userId || isAdmin()) &&
                       incoming().keys().hasAll(['demoBalance', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'demoBalance', 'balance', 'currency', 'isDemo', 'createdAt', 'updatedAt']) &&
                       isValidBalance(incoming(), userId);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       (request.auth.uid == userId || isAdmin()) &&
                       isValidBalance(incoming(), userId) &&
                       (!('userId' in existing()) || incoming().userId == existing().userId) &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['demoBalance', 'balance', 'currency', 'isDemo', 'updatedAt']);

      allow delete: if false;
    }

    // 3. Transactions Collection (/transactions/{transactionId})
    match /transactions/{transactionId} {
      allow get: if isSignedIn() &&
                    isValidId(transactionId) &&
                    (existing().uid == request.auth.uid ||
                     ('userId' in existing() && existing().userId == request.auth.uid) ||
                     isAdmin());

      allow list: if isSignedIn() &&
                     (existing().uid == request.auth.uid ||
                      ('userId' in existing() && existing().userId == request.auth.uid) ||
                      isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(transactionId) &&
                       incoming().keys().hasAll(['uid', 'amount', 'recipientName', 'recipientUPI', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['uid', 'userId', 'amount', 'recipientName', 'recipientUPI', 'recipientUpiId', 'currency', 'status', 'isSimulated', 'note', 'referenceId', 'createdAt']) &&
                       isValidTransaction(incoming());

      allow update, delete: if false;
    }
  }
}
